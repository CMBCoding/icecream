<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- favicon -->
    <link rel="shortcut icon" href="images/favicon.ico" type="image/x-icon">
    <!-- stylesheet -->
    <link rel="stylesheet" href="styles/style.css">
    <!-- Scripts -->
    <script src="js/icecream.js" defer></script>
    <title>Admin</title>
    <!-- data table resources -->
     <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
     <script src="https://cdn.datatables.net/3.1.4/js/dataTables.min.js"></script>
     <link rel="stylesheet" href="https://cdn.datatables.net/3.1.4/css/dataTables.dataTables.min.css">
</head>
<body>
    <main>
        <h1>Orders</h1>
        <table id="order-table" class="display">
            <thead>
                <tr>
                    <td>Name</td>
                    <td>Email</td>
                    <td>Flavors</td>
                    <td>Cone</td>
                    <td>Toppings</td>
                    <td>Comments</td>
                    <td>Date/Time</td>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td><%= order.name %></td>
                        <td><%= order.email %></td>
                        <td><%= order.flavors %></td>
                        <td><%= order.cone %></td>
                        <td><%= order.toppings %></td>
                        <td><%= order.comment %></td>
                        <td><%= order.timestamp %></td>
                    </tr>
                    
               <% }); %>
            </tbody>
        </table>
        <script>
            new DataTable("#order-table")
        </script>
    </main>
    

</body>
</html>